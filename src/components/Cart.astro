---
// Bouton flottant « Ma commande » + fenêtre de la commande, présents sur toutes les pages.
// La commande n'est pas envoyée : le visiteur appelle une boutique avec sa liste sous les yeux.
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { shops, telHref } from '../data/site';
---

<button class="fab" type="button" data-cart-open hidden>
  <Icon name="bag" />
  <span class="fab__label">Ma commande</span>
  <span class="fab__count" data-cart-count>0</span>
  <span class="fab__total" data-cart-total></span>
</button>

<dialog class="cart is-empty" data-cart-dialog aria-labelledby="cart-title">
  <div class="cart__inner">
    <header class="cart__head">
      <h2 id="cart-title" tabindex="-1" autofocus>Ma commande</h2>
      <button class="cart__close" type="button" data-cart-close aria-label="Fermer la commande">
        <Icon name="close" />
      </button>
    </header>

    <p class="cart__empty">
      Votre commande est vide. Ajoutez des pizzas avec le bouton <strong>+</strong> sur <a href="/carte">la carte</a>.
    </p>

    <ul class="cart__list" data-cart-list></ul>

    <div class="cart__summary">
      <p class="cart__total">
        <span>Total</span>
        <strong data-cart-dialog-total></strong>
      </p>
      <button class="cart__clear" type="button" data-cart-clear>Vider</button>
    </div>

    <section class="cart__call" aria-labelledby="cart-call-title">
      <h3 id="cart-call-title">Appelez la boutique de votre choix</h3>
      <p class="cart__note">
        Votre commande n’est pas envoyée : gardez cette liste à l’écran et dictez-la au téléphone.
      </p>
      <ul class="cart__shops">
        {
          shops.map((shop) => (
            <li>
              <a href={telHref(shop.phone)} class="cart__shop">
                <Icon name="phone" />
                <span class="cart__shop-name">{shop.name}</span>
                <span class="cart__shop-phone">{shop.phone}</span>
              </a>
              <OpenStatus shop={shop.id} compact />
            </li>
          ))
        }
      </ul>
    </section>

    <p class="visually-hidden" aria-live="polite" data-cart-live></p>
  </div>
</dialog>

<script>
  import '../scripts/cart';
</script>

<style>
  /* Bouton flottant */
  .fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem 0.7rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-text);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 10px 24px -10px rgb(28 28 26 / 0.55);
    cursor: pointer;
    animation: rise 0.45s var(--ease-out);
  }

  .fab[hidden] {
    display: none;
  }

  .fab:hover {
    background: var(--color-primary);
  }

  .fab :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .fab__count {
    display: grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0.1rem 0.35rem 0;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    font-size: 0.9rem;
  }

  .fab:hover .fab__count {
    background: var(--color-text);
  }

  .fab__total {
    font-variant-numeric: tabular-nums;
  }

  @keyframes rise {
    from {
      transform: translateY(120%);
    }
  }

  :global(body.has-cart) {
    padding-bottom: 5rem;
  }

  /* Fenêtre : panneau à droite sur desktop, feuille en bas sur mobile. */
  .cart {
    width: min(440px, 100%);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .cart::backdrop {
    background: rgb(28 28 26 / 0.55);
  }

  .cart[open] {
    animation: slide-in 0.35s var(--ease-out);
  }

  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }

  .cart__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 100%;
    padding: 1.5rem clamp(1.25rem, 4vw, 2rem) 2rem;
  }

  .cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-primary);
  }

  .cart__head h2 {
    margin: 0;
    font-size: 2rem;
    outline: none;
  }

  .cart__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .cart__close :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .cart__empty {
    margin: 0;
    font-size: 1.05rem;
  }

  .cart__empty a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .cart:not(.is-empty) .cart__empty,
  .cart.is-empty .cart__list,
  .cart.is-empty .cart__summary,
  .cart.is-empty .cart__call {
    display: none;
  }

  .cart__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart__list :global(.cart__line) {
    display: grid;
    grid-template-columns: 1fr auto 5.5rem;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.7rem;
    border-bottom: 2px dotted rgb(28 28 26 / 0.25);
  }

  .cart__list :global(.cart__name) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .cart__list :global(.cart__price) {
    font-family: var(--font-display);
    font-weight: 800;
    text-align: right;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .cart__summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart__total {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cart__total strong {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--color-primary);
  }

  .cart__clear {
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .cart__call {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-primary);
  }

  .cart__call h3 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .cart__note {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .cart__shops {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart__shops li {
    display: grid;
    gap: 0.35rem;
  }

  .cart__shop {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s var(--ease-out);
  }

  .cart__shop:hover {
    background: var(--color-primary-dark);
  }

  .cart__shop :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .cart__shop-phone {
    font-variant-numeric: tabular-nums;
  }

  .cart__shops :global(.status) {
    padding-left: 0.25rem;
  }

  @media (max-width: 640px) {
    .fab {
      left: max(1rem, env(safe-area-inset-left));
      justify-content: center;
    }

    .cart {
      width: 100%;
      height: auto;
      max-height: 88dvh;
      margin: auto 0 0;
      border-radius: var(--radius) var(--radius) 0 0;
    }

    .cart[open] {
      animation-name: slide-up;
    }

    @keyframes slide-up {
      from {
        transform: translateY(100%);
      }
    }

    .cart__inner {
      min-height: 0;
    }
  }
</style>
