---
interface Props {
  name: 'phone' | 'pin' | 'arrow' | 'clock' | 'mail' | 'play' | 'pause' | 'star' | 'instagram' | 'bag' | 'close' | 'plus' | 'minus';
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'phone' && (
      <path d="M21 16.4v3a2 2 0 0 1-2.2 2 19.6 19.6 0 0 1-8.5-3 19.3 19.3 0 0 1-6-6 19.6 19.6 0 0 1-3-8.6A2 2 0 0 1 3.3 1.6h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L7.3 9.4a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M19.5 10c0 5.6-7.5 11.5-7.5 11.5S4.5 15.6 4.5 10a7.5 7.5 0 0 1 15 0Z" />
        <circle cx="12" cy="10" r="2.6" />
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M4.5 12h15" />
        <path d="m13 5.5 6.5 6.5-6.5 6.5" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.2 2" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
        <path d="m21.5 7-9.5 6L2.5 7" />
      </>
    )
  }
  {
    name === 'star' && (
      <path
        d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'bag' && (
      <>
        <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" />
        <path d="M9 10V6.5a3 3 0 0 1 6 0V10" />
      </>
    )
  }
  {name === 'plus' && <path d="M12 5v14M5 12h14" stroke-width="3" />}
  {name === 'minus' && <path d="M5 12h14" stroke-width="3" />}
  {
    name === 'close' && (
      <>
        <path d="M6 6l12 12" />
        <path d="M18 6 6 18" />
      </>
    )
  }
  {name === 'play' && <path d="M7 4.5v15l12-7.5-12-7.5Z" fill="currentColor" />}
  {
    name === 'pause' && (
      <>
        <path d="M8 5v14" />
        <path d="M16 5v14" />
      </>
    )
  }
</svg>
