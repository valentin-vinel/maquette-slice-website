---
// Affiche un média de src/data/media.ts, ou son emplacement « à fournir » tant que `src` est vide.
import Icon from './Icon.astro';
import type { MediaSlot } from '../data/media';

interface Props {
  media: MediaSlot;
  tone?: 'light' | 'dark';
  eager?: boolean;
  class?: string;
}

const { media, tone = 'light', eager = false, class: className } = Astro.props;
---

<div class:list={['media', `media--${tone}`, className]}>
  {
    !media.src ? (
      <div class="placeholder">
        <span class="placeholder__tag">{media.kind === 'video' ? 'Vidéo à fournir' : 'Photo à fournir'}</span>
        <p class="placeholder__title">{media.title}</p>
        <p class="placeholder__brief">{media.brief}</p>
        <p class="placeholder__specs">{media.specs}</p>
      </div>
    ) : media.kind === 'photo' ? (
      <img src={media.src} alt={media.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <>
        <video muted loop playsinline preload="none" poster={media.poster} aria-label={media.alt} data-hero-video>
          {media.webm && <source src={media.webm} type="video/webm" />}
          <source src={media.src} type="video/mp4" />
        </video>
        <button class="media__toggle" type="button" aria-label="Mettre la vidéo en pause" hidden data-video-toggle>
          <span class="media__pause"><Icon name="pause" /></span>
          <span class="media__play"><Icon name="play" /></span>
        </button>
      </>
    )
  }
</div>

<script>
  // Lecture automatique sauf si l'utilisateur limite les animations ou ses données ; bouton pause toujours présent.
  document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((video) => {
    const toggle = video.parentElement?.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    const sync = () => {
      if (!toggle) return;
      toggle.classList.toggle('is-paused', video.paused);
      toggle.setAttribute('aria-label', video.paused ? 'Lire la vidéo' : 'Mettre la vidéo en pause');
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    toggle?.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    if (toggle) toggle.hidden = false;
    if (!reduce && !saveData) video.play().catch(sync);
    sync();
  });
</script>

<style>
  .media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }

  /* Un emplacement vide garde le format du média attendu, mais s'agrandit si son texte déborde. */
  .media:has(.placeholder) {
    overflow: visible;
  }

  img,
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    align-content: center;
    gap: 0.6rem;
    box-sizing: border-box;
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 2px dashed currentColor;
    border-radius: inherit;
  }

  .media--light .placeholder {
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .media--dark .placeholder {
    background: var(--color-primary-dark);
    color: var(--color-on-primary);
  }

  .placeholder p {
    margin: 0;
  }

  .placeholder__tag {
    justify-self: start;
    padding: 0.3rem 0.7rem 0.2rem;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .media--light .placeholder__tag {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .media--dark .placeholder__tag {
    background: var(--color-on-primary);
    color: var(--color-primary-dark);
  }

  .placeholder__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .placeholder__brief {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-text);
  }

  .media--dark .placeholder__brief {
    color: var(--color-on-primary);
  }

  .placeholder__specs {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .media__toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-primary);
    cursor: pointer;
  }

  .media__toggle :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .media__play,
  .media__toggle.is-paused .media__pause {
    display: none;
  }

  .media__toggle.is-paused .media__play {
    display: contents;
  }
</style>
