---
// Bandeau d'avis qui défile de droite à gauche, en boucle.
// Pause au survol, au focus clavier et via le bouton ; défilement manuel si l'utilisateur limite les animations.
import Icon from './Icon.astro';
import ReviewCard from './ReviewCard.astro';
import type { Review } from '../data/reviews';

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
// Vitesse constante quel que soit le nombre d'avis : ~11 s par carte.
const duration = `${reviews.length * 11}s`;
---

<div class="marquee" data-marquee style={`--marquee-duration: ${duration}`}>
  <div class="marquee__track">
    <ul class="marquee__list" aria-label="Avis clients">
      {reviews.map((review) => <li><ReviewCard review={review} /></li>)}
    </ul>
    <!-- Copie pour une boucle sans à-coup ; ignorée par les lecteurs d'écran. -->
    <ul class="marquee__list marquee__list--copy" aria-hidden="true" inert>
      {reviews.map((review) => <li><ReviewCard review={review} /></li>)}
    </ul>
  </div>
</div>

<button class="marquee__toggle" type="button" aria-pressed="false" data-marquee-toggle hidden>
  <span class="marquee__pause"><Icon name="pause" /> Mettre en pause</span>
  <span class="marquee__play"><Icon name="play" /> Reprendre le défilement</span>
</button>

<script>
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  if (marquee && toggle && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const paused = marquee.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
    });
  }
</script>

<style>
  .marquee {
    overflow: hidden;
    /* Fondu sur les bords pour que les cartes entrent et sortent en douceur. */
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration, 60s) linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track,
  .marquee.is-paused .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee__list {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0 1rem 0 0;
    list-style: none;
  }

  .marquee__list li {
    flex: none;
    width: min(340px, 80vw);
  }

  .marquee__toggle {
    display: flex;
    align-items: center;
    width: fit-content;
    margin: 1rem auto 0;
    padding: 0.4rem 0.2rem;
    border: 0;
    background: none;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .marquee__toggle[hidden] {
    display: none;
  }

  .marquee__toggle:hover {
    color: var(--color-primary);
  }

  .marquee__toggle span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .marquee__toggle :global(svg) {
    width: 0.95em;
    height: 0.95em;
  }

  .marquee__toggle .marquee__play,
  .marquee__toggle[aria-pressed='true'] .marquee__pause {
    display: none;
  }

  .marquee__toggle[aria-pressed='true'] .marquee__play {
    display: inline-flex;
  }

  /* Animations réduites : pas de défilement automatique, la liste se fait glisser à la main. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      mask-image: none;
      padding-bottom: 0.75rem;
    }

    .marquee__list li {
      scroll-snap-align: start;
    }

    .marquee__list--copy {
      display: none;
    }
  }
</style>
