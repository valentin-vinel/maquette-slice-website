---
// « La pizza du mois » (accueil et /carte) : pizzaOfTheMonth de menu.ts. Les pages ne l'affichent que si `item` est renseigné.
import MenuItem from './MenuItem.astro';
import { pizzaOfTheMonth, pizzas, itemId } from '../data/menu';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { month, item } = pizzaOfTheMonth;
---

{
  item && (
    <section class:list={['mois', className]} aria-labelledby="mois-title">
      <div class="mois__head">
        <h2 id="mois-title">La pizza du mois</h2>
        {month && <p class="mois__month">{month}</p>}
        <p class="mois__note">En plus de la carte, le temps d’un mois.</p>
      </div>

      <div class="mois__item">
        <MenuItem item={item} id={itemId(pizzas.id, item)} configurable />
      </div>
    </section>
  )
}

<style>
  .mois {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 3px solid var(--color-primary);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .mois__head h2 {
    margin: 0;
    color: var(--color-primary);
  }

  .mois__month {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.95rem, 2vw, 1.3rem);
    letter-spacing: 0.38em;
    text-transform: uppercase;
  }

  .mois__note {
    margin: 1rem 0 0;
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .mois {
      grid-template-columns: 1fr;
    }
  }
</style>
