---
// Un avis client réel, ou son emplacement « avis à fournir » tant que `text` est vide.
import type { Review } from '../data/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

{
  review.text ? (
    <figure class="review">
      <blockquote>
        <p>{review.text}</p>
      </blockquote>
      <figcaption>
        <strong>{review.author}</strong>
        {review.date && <span> · {review.date}</span>}
        {review.shop && <span> · {review.shop}</span>}
      </figcaption>
    </figure>
  ) : (
    <div class="review review--placeholder">
      <span class="review__tag">Avis à fournir</span>
      <p class="review__brief">
        Recopier un vrai avis Google, tel quel : 2 à 3 phrases qui parlent des pizzas ou de l’accueil.
      </p>
      <p class="review__specs">Prénom + initiale · mois et année · boutique (Carnot ou République)</p>
    </div>
  )
}

<style>
  .review {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  blockquote {
    margin: 0;
    flex: 1;
  }

  blockquote p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  blockquote p::before {
    content: '« ';
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 800;
  }

  blockquote p::after {
    content: ' »';
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 800;
  }

  figcaption {
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  figcaption strong {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
  }

  .review--placeholder {
    gap: 0.75rem;
    border: 2px dashed var(--color-primary);
  }

  .review__tag {
    align-self: flex-start;
    padding: 0.3rem 0.7rem 0.2rem;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .review__brief,
  .review__specs {
    margin: 0;
  }

  .review__specs {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
</style>
