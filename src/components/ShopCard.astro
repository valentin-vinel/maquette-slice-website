---
// Fiche d'une boutique : nom, adresse, statut en direct, horaires, appel et itinéraire.
import Icon from './Icon.astro';
import Hours from './Hours.astro';
import OpenStatus from './OpenStatus.astro';
import { telHref, type Shop } from '../data/site';

interface Props {
  shop: Shop;
  tone?: 'light' | 'dark';
  headingLevel?: 'h2' | 'h3';
}

const { shop, tone = 'light', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['shop', `shop--${tone}`]} id={shop.id}>
  <Heading class="shop__name">{shop.name}</Heading>
  <p class="shop__address">
    {shop.street}<br />
    {shop.city}
  </p>
  {
    shop.closed ? (
      <p class="shop__closed">Fermée temporairement</p>
    ) : (
      <>
        <OpenStatus shop={shop.id} tone={tone} />
        <div class="shop__hours">
          <Hours hours={shop.hours} tone={tone} />
        </div>
      </>
    )
  }

  <div class="shop__actions">
    {
      !shop.closed && (
        <a href={telHref(shop.phone)} class="btn shop__call">
          <Icon name="phone" />
          {shop.phone}
        </a>
      )
    }
    <a href={shop.mapsUrl} class="btn btn--ghost shop__map" target="_blank" rel="noopener noreferrer">
      <Icon name="pin" />
      Itinéraire
    </a>
  </div>
</article>

<style>
  .shop {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius);
    scroll-margin-top: 6rem;
  }

  .shop--light {
    background: var(--color-surface);
  }

  .shop--dark {
    border: 2px solid rgb(246 241 222 / 0.45);
    color: var(--color-on-primary);
  }

  .shop__name {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .shop--dark .shop__name {
    color: var(--color-on-primary);
  }

  .shop__address {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .shop__closed {
    margin: 0 0 auto;
    padding: 0.45rem 0.9rem 0.35rem;
    border: 2px solid currentColor;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .shop__hours {
    align-self: stretch;
    margin-bottom: auto;
  }

  .shop__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-self: stretch;
    margin-top: 0.5rem;
  }

  .shop__actions .btn {
    flex: 1 1 auto;
  }

  .shop--dark .shop__call {
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
    color: var(--color-primary);
  }

  .shop--dark .shop__call:hover {
    background: transparent;
    color: var(--color-on-primary);
  }

  .shop--dark .shop__map {
    border-color: var(--color-on-primary);
    color: var(--color-on-primary);
  }

  .shop--dark .shop__map:hover {
    background: var(--color-on-primary);
    color: var(--color-primary);
  }

  .shop--dark a:focus-visible {
    outline-color: var(--color-on-primary);
  }
</style>
