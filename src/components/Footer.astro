---
import Logo from './Logo.astro';
import { nav, shops, site, telHref } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo tone="cream" class="footer__logo" />
    </div>

    <div class="footer__shops">
      <h2>Nos boutiques</h2>
      <ul>
        {
          shops.map((shop) => (
            <li>
              <a href={shop.mapsUrl} target="_blank" rel="noopener noreferrer">
                <strong>{shop.name}</strong> · {shop.street}
              </a>
              <br />
              {shop.closed ? <span>Fermée temporairement</span> : <a href={telHref(shop.phone)}>{shop.phone}</a>}
            </li>
          ))
        }
      </ul>
      <p class="footer__mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <div>
      <h2>Navigation</h2>
      <ul>
        {nav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>

    {site.socials.length > 0 && <div>
      <h2>Suivez-nous</h2>
      <ul>
        {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
      </ul>
    </div>}
  </div>

  <div class="container footer__bottom">
    <p>© {year} {site.name} · {site.tagline}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-text);
    color: var(--color-on-primary);
    padding-top: clamp(3.5rem, 7vw, 5rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer__brand :global(.footer__logo) {
    width: min(170px, 100%);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    color: var(--color-on-primary);
    opacity: 0.7;
  }

  p {
    line-height: 1.7;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .footer__shops ul {
    gap: 0.85rem;
    line-height: 1.5;
  }

  .footer__shops strong {
    font-weight: 600;
  }

  .footer__mail {
    margin-top: 1rem;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline-color: var(--color-on-primary);
  }

  .footer__bottom {
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(246 241 222 / 0.15);
    font-size: 0.875rem;
    color: rgb(246 241 222 / 0.7);
  }

  .footer__bottom p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__brand :global(.footer__logo) {
      width: 130px;
    }
  }
</style>
