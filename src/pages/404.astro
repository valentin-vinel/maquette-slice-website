---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="Page introuvable">
  <section class="section">
    <div class="container">
      <Frame class="notfound">
        <Logo tone="primary" class="notfound__logo" />
        <h1>Cette part a disparu…</h1>
        <p>La page que vous cherchez n’existe pas ou a été déplacée.</p>
        <div class="notfound__actions">
          <a href="/" class="btn">Retour à l’accueil</a>
          <a href="/carte" class="btn btn--ghost">Voir la carte</a>
        </div>
      </Frame>
    </div>
  </section>
</Layout>

<style>
  .section :global(.notfound) {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .section :global(.notfound__logo) {
    width: min(220px, 60%);
    margin-bottom: 2rem;
    animation: settle 1.2s var(--ease-out) both;
  }

  @keyframes settle {
    from {
      transform: rotate(24deg);
    }
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }

  p {
    font-size: 1.15rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
